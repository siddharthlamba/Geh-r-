# Gehor Configuration (Strictly Free-Tier ₹0 Budget)
# Get your free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# Eligible free-tier models: gemini-1.5-flash, gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-flash

# Request timeout in seconds
GEMINI_TIMEOUT_SECONDS=10

# Autonomous routing confidence threshold (0.0 to 1.0)
ROUTING_AUTONOMOUS_CONFIDENCE_THRESHOLD=0.85

# Database URL
DATABASE_URL=sqlite:///./gehor.db
